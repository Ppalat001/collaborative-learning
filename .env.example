# Copy to .env for local development. On Railway, set these under Service -> Variables.

# SQLite file. Locally defaults to ./data/research.db.
# On Railway, attach a Volume mounted at /data and use:
# DATABASE_URL=file:/data/research.db
DATABASE_URL=

# Without a key the app uses demo (template) AI text, recorded as ai_origin "mock".
# Set it before running real groups.
OPENAI_API_KEY=
# Model name sent to the Responses API; defaults to gpt-4o-mini when empty.
# Example that works with a current OpenAI key: gpt-6-luna
# Changing it only needs a restart (locally) or a redeploy (Railway).
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible provider URL; empty = OpenAI.
# e.g. https://openrouter.ai/api/v1 or https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Required in production (admin exports are disabled without it).
# Locally defaults to "research-admin".
ADMIN_PASSWORD=

# Leave empty when the Socket.io server runs on the same domain (local and Railway).
NEXT_PUBLIC_SOCKET_URL=

# --- Adaptive Scaffolding V2 (docs/adaptive-scaffolding-v2/06-researcher-operating-guide.md) ---
# V2 is ON by default: with all of these empty, every new group (home page and /admin)
# is a V2 proactive_adaptive group (shared group facilitator + adaptive private popup
# suggestions on policy-v2-2). Settings only affect groups created afterwards;
# existing groups (including legacy groups) never change.
# "false" switches V2 off: every new group is a legacy group again.
ADAPTIVE_V2_ENABLED=
# v2 (default) | legacy: "legacy" keeps home-page groups legacy while /admin can still create V2 groups.
ADAPTIVE_V2_HOME_PAGE_GROUPS=
# Condition for home-page groups (default proactive_adaptive). Use proactive_group for
# the facilitator without private popups.
ADAPTIVE_V2_DEFAULT_CONDITION=
# fixed (default) | randomized, and the comma-separated conditions to draw from.
ADAPTIVE_V2_ASSIGNMENT=
ADAPTIVE_V2_RANDOMIZE_CONDITIONS=
# Intervention policy for NEW groups (default: "current" in src/data/intervention-policies.json,
# which is policy-v2-3). Set to policy-v2-2 to keep a cohort that is still collecting data on
# policy-v2-2 unchanged. Existing groups always keep the policy they were created with.
ADAPTIVE_V2_POLICY_VERSION=
# "true" enables the optional researcher rubric for written pre/post question 9 in /admin
# (stored separately; the multiple-choice score never changes). Default off.
ADAPTIVE_V2_OPEN_ANSWER_RUBRIC=
# "true" allows the seconds-scale test policy (automated tests only). Keep empty in production.
ADAPTIVE_V2_ALLOW_TEST_POLICY=
# Re-evaluation interval for connected V2 scenario rooms in ms (default 5000).
ADAPTIVE_V2_SCHEDULER_MS=
