{
  "name": "collaborative-learning",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run db:push && tsx watch server.ts",
    "build": "next build",
